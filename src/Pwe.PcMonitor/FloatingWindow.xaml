<Window x:Class="Pwe.PcMonitor.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PWE PC MONITOR"
        Width="244" Height="72" MinWidth="244" MinHeight="72" MaxWidth="244" MaxHeight="72"
        SizeToContent="Manual" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Border x:Name="CompactSurface"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource StrokeBrush}"
            BorderThickness="1" CornerRadius="18" Padding="9,8"
            MouseEnter="CompactSurface_MouseEnter" MouseLeave="CompactSurface_MouseLeave"
            MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Width="28" Height="28" CornerRadius="9"
                    Background="{DynamicResource BadgeWarmBrush}" Padding="3">
                <Image Source="Resources/AppIcon.png" Stretch="Uniform" Opacity="0.94"
                       AutomationProperties.Name="PWE wing mark" />
            </Border>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="8,0,4,0">
                <Grid Width="50" Margin="0,0,4,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="CPU" Style="{StaticResource SectionLabelStyle}" />
                    <TextBlock Grid.Column="1" Text="{Binding CpuValue}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{Binding CpuHealth, Converter={StaticResource HealthBrush}}" />
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding CpuSub}"
                               Style="{StaticResource MutedTextStyle}" FontSize="9" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasCpuSub, Converter={StaticResource BoolVisibility}}" />
                </Grid>

                <Grid Width="50" Margin="0,0,4,0"
                      Visibility="{Binding HasMemoryData, Converter={StaticResource BoolVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="MEM" Style="{StaticResource SectionLabelStyle}" />
                    <TextBlock Grid.Column="1" Text="{Binding Snapshot.MemoryUsedPercent, StringFormat={}{0:0}%}"
                               FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding MemoryAvailable}"
                               Style="{StaticResource MutedTextStyle}" FontSize="9" TextTrimming="CharacterEllipsis" />
                </Grid>

                <Grid Width="50" Margin="0,0,4,0"
                      Visibility="{Binding HasCompactSecondary, Converter={StaticResource BoolVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding CompactSecondaryLabel}" Style="{StaticResource SectionLabelStyle}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding CompactSecondaryValue}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{Binding CompactSecondaryHealth, Converter={StaticResource HealthBrush}}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding CompactSecondarySub}"
                               Style="{StaticResource MutedTextStyle}" FontSize="9" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasCompactSecondarySub, Converter={StaticResource BoolVisibility}}" />
                </Grid>
            </StackPanel>

            <Button Grid.Column="2" Content="✦" Width="24" Height="24"
                    Style="{StaticResource SmallButtonStyle}" Padding="0" FontSize="12"
                    IsEnabled="{Binding CanOptimizeMemory}" Click="OptimizeMemory_Click"
                    ToolTip="Optimize memory · Ctrl+Shift+M"
                    AutomationProperties.Name="Optimize memory" />
        </Grid>
        </Border>

        <Popup x:Name="DetailPopup" PlacementTarget="{Binding ElementName=CompactSurface}"
           Placement="Custom" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade"
           Opened="DetailPopup_Opened">
        <Border x:Name="DetailSurface" Width="320"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="1" CornerRadius="18" Padding="14,13,14,12"
                MouseEnter="DetailSurface_MouseEnter" MouseLeave="DetailSurface_MouseLeave"
                PreviewKeyDown="DetailSurface_PreviewKeyDown" Focusable="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="10"
                            Background="{DynamicResource BadgeWarmBrush}" Padding="3">
                        <Image Source="Resources/AppIcon.png" Stretch="Uniform" Opacity="0.94"
                               AutomationProperties.Name="PWE wing mark" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,10,0">
                        <TextBlock Text="{Binding MachineSummary}" FontSize="12" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Snapshot.ProcessorName}" Style="{StaticResource MutedTextStyle}"
                                   FontSize="10" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="×" Style="{StaticResource SmallButtonStyle}"
                            Padding="7,1" FontSize="16" Click="CloseWidget_Click"
                            ToolTip="Close floating widget" AutomationProperties.Name="Close floating widget" />
                </Grid>

                <WrapPanel Grid.Row="1" ItemWidth="146" Margin="0,0,0,2">
                    <Border Width="140" Height="48" Margin="0,0,6,6"
                            Background="{DynamicResource RailBrush}" CornerRadius="10" Padding="9,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CPU" Style="{StaticResource SectionLabelStyle}" />
                            <TextBlock Grid.Column="1" Text="{Binding CpuValue}" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{Binding CpuHealth, Converter={StaticResource HealthBrush}}" />
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding CpuSub}"
                                       Style="{StaticResource MutedTextStyle}" FontSize="10" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding HasCpuSub, Converter={StaticResource BoolVisibility}}" />
                        </Grid>
                    </Border>

                    <Border Width="140" Height="48" Margin="0,0,6,6"
                            Background="{DynamicResource RailBrush}" CornerRadius="10" Padding="9,6"
                            Visibility="{Binding HasGpuData, Converter={StaticResource BoolVisibility}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="GPU" Style="{StaticResource SectionLabelStyle}" />
                            <TextBlock Grid.Column="1" Text="{Binding GpuValue}" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{Binding GpuHealth, Converter={StaticResource HealthBrush}}"
                                       Visibility="{Binding HasGpuUsage, Converter={StaticResource BoolVisibility}}" />
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding GpuSub}"
                                       Style="{StaticResource MutedTextStyle}" FontSize="10" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding HasGpuSub, Converter={StaticResource BoolVisibility}}" />
                        </Grid>
                    </Border>

                    <Border Width="140" Height="48" Margin="0,0,6,6"
                            Background="{DynamicResource RailBrush}" CornerRadius="10" Padding="9,6"
                            Visibility="{Binding HasMemoryData, Converter={StaticResource BoolVisibility}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="MEMORY" Style="{StaticResource SectionLabelStyle}" />
                            <TextBlock Grid.Column="1" Text="{Binding Snapshot.MemoryUsedPercent, StringFormat={}{0:0}%}"
                                       FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding MemoryAvailable}"
                                       Style="{StaticResource MutedTextStyle}" FontSize="10" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>

                    <Border Width="140" Height="48" Margin="0,0,6,6"
                            Background="{DynamicResource RailBrush}" CornerRadius="10" Padding="9,6"
                            Visibility="{Binding HasPowerData, Converter={StaticResource BoolVisibility}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="POWER" Style="{StaticResource SectionLabelStyle}" />
                            <TextBlock Grid.Column="1" Text="{Binding PowerValue}" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{Binding PowerHealth, Converter={StaticResource HealthBrush}}" />
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding PowerSub}"
                                       Style="{StaticResource MutedTextStyle}" FontSize="10" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding HasPowerSub, Converter={StaticResource BoolVisibility}}" />
                        </Grid>
                    </Border>

                    <Border Width="140" Height="48" Margin="0,0,6,6"
                            Background="{DynamicResource RailBrush}" CornerRadius="10" Padding="9,6"
                            Visibility="{Binding HasFans, Converter={StaticResource BoolVisibility}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="FAN" Style="{StaticResource SectionLabelStyle}" />
                            <TextBlock Grid.Column="1" Text="{Binding FanValue}" FontSize="16" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding FanSub}"
                                       Style="{StaticResource MutedTextStyle}" FontSize="10" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>

                    <Border Width="140" Height="48" Margin="0,0,6,6"
                            Background="{DynamicResource RailBrush}" CornerRadius="10" Padding="9,6"
                            Visibility="{Binding HasBattery, Converter={StaticResource BoolVisibility}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="BATTERY" Style="{StaticResource SectionLabelStyle}" />
                            <TextBlock Grid.Column="1" Text="{Binding BatteryValue}" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding BatteryState}"
                                       Style="{StaticResource MutedTextStyle}" FontSize="10" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                </WrapPanel>

                <Border Grid.Row="2" Background="{DynamicResource RailBrush}" CornerRadius="10" Padding="8,5"
                        Visibility="{Binding HasMemoryData, Converter={StaticResource BoolVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="✦ Optimize memory" Style="{StaticResource SmallButtonStyle}"
                                Padding="5,2" IsEnabled="{Binding CanOptimizeMemory}"
                                Click="OptimizeMemory_Click"
                                ToolTip="Optimize memory (Ctrl+Shift+M)"
                                AutomationProperties.Name="Optimize memory" />
                        <TextBlock Grid.Column="2" Text="{Binding MemoryActionStatus}"
                                   Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasMemoryActionStatus, Converter={StaticResource BoolVisibility}}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
        </Popup>
    </Grid>
</Window>
