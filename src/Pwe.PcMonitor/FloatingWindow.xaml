<Window x:Class="Pwe.PcMonitor.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PWE PC MONITOR"
        Width="326" MinWidth="290" MinHeight="150" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Closing="Window_Closing">
    <Border Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource StrokeBrush}"
            BorderThickness="1" CornerRadius="16" Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="11"
                        Background="{DynamicResource BadgeWarmBrush}" Padding="3">
                    <Image Source="Resources/AppIcon.png" Stretch="Uniform" Opacity="0.94"
                           AutomationProperties.Name="PWE wing mark" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="{Binding MachineSummary}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Snapshot.ProcessorName}" Style="{StaticResource MutedTextStyle}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="2" Content="×" Style="{StaticResource SmallButtonStyle}"
                        Padding="7,1" FontSize="16" Click="CloseWidget_Click" />
            </Grid>

            <WrapPanel Grid.Row="1" Margin="0,12,0,10">
                <StackPanel Width="58" Margin="0,0,8,8">
                    <TextBlock Text="CPU" Style="{StaticResource SectionLabelStyle}" />
                    <TextBlock Text="{Binding CpuValue}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{Binding CpuHealth, Converter={StaticResource HealthBrush}}" />
                    <TextBlock Text="{Binding CpuSub}" Style="{StaticResource MutedTextStyle}"
                               Visibility="{Binding HasCpuSub, Converter={StaticResource BoolVisibility}}" />
                </StackPanel>
                <StackPanel Width="58" Margin="0,0,8,8"
                            Visibility="{Binding HasGpuData, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="GPU" Style="{StaticResource SectionLabelStyle}" />
                    <TextBlock Text="{Binding GpuValue}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{Binding GpuHealth, Converter={StaticResource HealthBrush}}"
                               Visibility="{Binding HasGpuUsage, Converter={StaticResource BoolVisibility}}" />
                    <TextBlock Text="{Binding GpuSub}" Style="{StaticResource MutedTextStyle}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasGpuSub, Converter={StaticResource BoolVisibility}}" />
                </StackPanel>
                <StackPanel Width="58" Margin="0,0,8,8"
                            Visibility="{Binding HasMemoryData, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="MEM" Style="{StaticResource SectionLabelStyle}" />
                    <TextBlock Text="{Binding Snapshot.MemoryUsedPercent, StringFormat={}{0:0}%}"
                               FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding MemoryAvailable}" Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
                <StackPanel Width="70" Margin="0,0,8,8" Visibility="{Binding HasFans, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="FAN" Style="{StaticResource SectionLabelStyle}" />
                    <TextBlock Text="{Binding FanValue}" FontSize="17" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding FanSub}" Style="{StaticResource MutedTextStyle}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Width="70" Margin="0,0,8,8" Visibility="{Binding HasPowerData, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="POWER" Style="{StaticResource SectionLabelStyle}" />
                    <TextBlock Text="{Binding PowerValue}" FontSize="17" FontWeight="SemiBold"
                               Foreground="{Binding PowerHealth, Converter={StaticResource HealthBrush}}" />
                    <TextBlock Text="{Binding PowerSub}" Style="{StaticResource MutedTextStyle}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasPowerSub, Converter={StaticResource BoolVisibility}}" />
                </StackPanel>
                <StackPanel Width="70" Margin="0,0,8,8" Visibility="{Binding HasBattery, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="BATTERY" Style="{StaticResource SectionLabelStyle}" />
                    <TextBlock Text="{Binding BatteryValue}" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding BatteryState}" Style="{StaticResource MutedTextStyle}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </WrapPanel>
        </Grid>
    </Border>
</Window>
