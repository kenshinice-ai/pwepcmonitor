<Window x:Class="Pwe.PcMonitor.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PWE PC MONITOR"
        Height="58" MinWidth="68" MinHeight="58" MaxHeight="58"
        SizeToContent="Width" WindowStyle="None" ResizeMode="NoResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="WidgetMetricStyle" TargetType="Border">
            <Setter Property="Width" Value="148" />
            <Setter Property="MinHeight" Value="64" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="9,9,9,8" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource WidgetTileBrush}" />
        </Style>
        <Style x:Key="WidgetLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource WidgetMutedBrush}" />
        </Style>
        <Style x:Key="WidgetSubStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource WidgetMutedBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="WidgetActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallButtonStyle}">
            <Setter Property="MinHeight" Value="32" />
        </Style>
    </Window.Resources>
    <Grid>
        <Border x:Name="CompactSurface"
            Background="{DynamicResource WidgetSurfaceBrush}"
            BorderBrush="{DynamicResource StrokeBrush}"
            BorderThickness="1" CornerRadius="18" Padding="10,7"
            MouseEnter="CompactSurface_MouseEnter" MouseLeave="CompactSurface_MouseLeave"
            MouseMove="CompactSurface_MouseMove"
            MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Width="28" Height="28" CornerRadius="9"
                    Background="{DynamicResource BadgeWarmBrush}" Padding="3">
                <Image Source="Resources/AppIcon.png" Stretch="Uniform" Opacity="0.94"
                       AutomationProperties.Name="PWE wing mark" />
            </Border>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="9,0,4,0">
                <Grid Width="52" Margin="0,0,2,0" ToolTip="CPU" Visibility="{Binding HasCpuUsage, Converter={StaticResource BoolVisibility}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource CpuIconGeometry}" Style="{StaticResource CompactIconStyle}"
                              AutomationProperties.Name="CPU" />
                        <TextBlock Text="{Binding CpuValue}" Margin="3,0,0,0" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{Binding CpuHealth, Converter={StaticResource HealthBrush}}" />
                    </StackPanel>
                </Grid>

                <Grid Width="52" Margin="0,0,2,0" ToolTip="Memory"
                      Visibility="{Binding HasMemoryData, Converter={StaticResource BoolVisibility}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource MemoryIconGeometry}" Style="{StaticResource CompactIconStyle}"
                              AutomationProperties.Name="Memory" />
                        <TextBlock Text="{Binding Snapshot.MemoryUsedPercent, StringFormat={}{0:0}%}"
                                   Margin="3,0,0,0" FontSize="13" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>

                <Grid Width="59" ToolTip="{Binding CompactSecondaryDescription}" AutomationProperties.Name="{Binding CompactSecondaryDescription}"
                      Visibility="{Binding HasCompactSecondary, Converter={StaticResource BoolVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource GpuIconGeometry}" Style="{StaticResource CompactIconStyle}"
                          Margin="0,0,3,0" Visibility="{Binding HasCompactGpu, Converter={StaticResource BoolVisibility}}"
                          AutomationProperties.Name="GPU" />
                    <Path Data="{StaticResource BatteryIconGeometry}" Style="{StaticResource CompactIconStyle}"
                          Margin="0,0,3,0" Visibility="{Binding HasCompactBattery, Converter={StaticResource BoolVisibility}}"
                          AutomationProperties.Name="Battery" />
                    <Path Data="{StaticResource PowerIconGeometry}" Style="{StaticResource CompactIconStyle}"
                          Margin="0,0,3,0" Visibility="{Binding HasCompactPower, Converter={StaticResource BoolVisibility}}"
                          AutomationProperties.Name="Power" />
                    <TextBlock Grid.Column="1" Text="{Binding CompactSecondaryValue}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{Binding CompactSecondaryHealth, Converter={StaticResource HealthBrush}}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </StackPanel>

            <Button Grid.Column="2" Width="32" Height="32"
                    Style="{StaticResource WidgetActionButtonStyle}" Padding="0" FontSize="12"
                    Foreground="{DynamicResource AccentBrush}"
                    IsEnabled="{Binding CanOptimizeMemory}" Click="OptimizeMemory_Click"
                    Visibility="{Binding HasMemoryData, Converter={StaticResource BoolVisibility}}"
                    ToolTip="Optimize memory · Ctrl+Shift+M"
                    AutomationProperties.Name="Optimize memory">
                <Path Data="{StaticResource SparkleIconGeometry}" Width="14" Height="14"
                      Stretch="Uniform" Fill="{DynamicResource AccentBrush}" />
            </Button>
        </Grid>
        </Border>

        <Popup x:Name="DetailPopup" PlacementTarget="{Binding ElementName=CompactSurface}"
           Placement="Custom" StaysOpen="True" AllowsTransparency="True"
           Opened="DetailPopup_Opened">
        <Border x:Name="DetailSurface" Width="350"
                Background="{DynamicResource WidgetSurfaceBrush}"
                BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="1" CornerRadius="18" Padding="16,14,16,14"
                MouseEnter="DetailSurface_MouseEnter" MouseLeave="DetailSurface_MouseLeave"
                PreviewKeyDown="DetailSurface_PreviewKeyDown" Focusable="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="2,0,10,0">
                        <TextBlock Text="{Binding MachineSummary}" FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Snapshot.ProcessorName}" Style="{StaticResource WidgetSubStyle}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="×" Style="{StaticResource SmallButtonStyle}"
                            Width="32" Height="32" Padding="0" FontSize="16" Click="CloseWidget_Click"
                            ToolTip="Close floating widget" AutomationProperties.Name="Close floating widget" />
                </Grid>

                <WrapPanel Grid.Row="1" ItemWidth="156" Margin="0,0,-4,0">
                    <Border Style="{StaticResource WidgetMetricStyle}" Visibility="{Binding HasCpuData, Converter={StaticResource BoolVisibility}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource CpuIconGeometry}" Style="{StaticResource DetailIconStyle}"
                                      AutomationProperties.Name="CPU" />
                                <TextBlock Text="CPU" Style="{StaticResource WidgetLabelStyle}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding CpuValue}" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{Binding CpuHealth, Converter={StaticResource HealthBrush}}" />
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding CpuSub}"
                                       Style="{StaticResource WidgetSubStyle}"
                                       Visibility="{Binding HasCpuSub, Converter={StaticResource BoolVisibility}}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource WidgetMetricStyle}"
                            Visibility="{Binding HasGpuData, Converter={StaticResource BoolVisibility}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GpuIconGeometry}" Style="{StaticResource DetailIconStyle}"
                                      AutomationProperties.Name="GPU" />
                                <TextBlock Text="GPU" Style="{StaticResource WidgetLabelStyle}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding GpuValue}" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{Binding GpuHealth, Converter={StaticResource HealthBrush}}"
                                       Visibility="{Binding HasGpuUsage, Converter={StaticResource BoolVisibility}}" />
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding GpuSub}"
                                       Style="{StaticResource WidgetSubStyle}"
                                       Visibility="{Binding HasGpuSub, Converter={StaticResource BoolVisibility}}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource WidgetMetricStyle}"
                            Visibility="{Binding HasMemoryData, Converter={StaticResource BoolVisibility}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource MemoryIconGeometry}" Style="{StaticResource DetailIconStyle}"
                                      AutomationProperties.Name="Memory" />
                                <TextBlock Text="MEMORY" Style="{StaticResource WidgetLabelStyle}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Snapshot.MemoryUsedPercent, StringFormat={}{0:0}%}"
                                       FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding MemoryAvailable, StringFormat={}{0} free}"
                                       Style="{StaticResource WidgetSubStyle}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource WidgetMetricStyle}"
                            Visibility="{Binding HasDiskData, Converter={StaticResource BoolVisibility}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource StorageIconGeometry}" Style="{StaticResource DetailIconStyle}"
                                      AutomationProperties.Name="Storage" />
                                <TextBlock Text="DISK" Style="{StaticResource WidgetLabelStyle}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding DiskValue}" FontSize="17" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding DiskTotal}"
                                       Style="{StaticResource WidgetSubStyle}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource WidgetMetricStyle}"
                            Visibility="{Binding HasPowerData, Converter={StaticResource BoolVisibility}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource PowerIconGeometry}" Style="{StaticResource DetailIconStyle}"
                                      AutomationProperties.Name="Power" />
                                <TextBlock Text="POWER" Style="{StaticResource WidgetLabelStyle}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding PowerValue}" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{Binding PowerHealth, Converter={StaticResource HealthBrush}}" />
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding PowerSub}"
                                       Style="{StaticResource WidgetSubStyle}"
                                       Visibility="{Binding HasPowerSub, Converter={StaticResource BoolVisibility}}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource WidgetMetricStyle}"
                            Visibility="{Binding HasFans, Converter={StaticResource BoolVisibility}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource FanIconGeometry}" Style="{StaticResource DetailIconStyle}"
                                      AutomationProperties.Name="Fan" />
                                <TextBlock Text="FAN" Style="{StaticResource WidgetLabelStyle}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding FanValue}" FontSize="16" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding FanSub}"
                                       Style="{StaticResource WidgetSubStyle}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource WidgetMetricStyle}"
                            Visibility="{Binding HasBattery, Converter={StaticResource BoolVisibility}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource BatteryIconGeometry}" Style="{StaticResource DetailIconStyle}"
                                      AutomationProperties.Name="Battery" />
                                <TextBlock Text="BATTERY" Style="{StaticResource WidgetLabelStyle}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding BatteryValue}" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding BatteryState}"
                                       Style="{StaticResource WidgetSubStyle}" />
                        </Grid>
                    </Border>
                </WrapPanel>

                <Border Grid.Row="2" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="0,9,0,0"
                        Visibility="{Binding HasMemoryData, Converter={StaticResource BoolVisibility}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button Style="{StaticResource WidgetActionButtonStyle}"
                                MinHeight="32" Padding="8,5" HorizontalAlignment="Left" IsEnabled="{Binding CanOptimizeMemory}"
                                Click="OptimizeMemory_Click"
                                ToolTip="Optimize memory (Ctrl+Shift+M)"
                                AutomationProperties.Name="Optimize memory">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource SparkleIconGeometry}" Width="13" Height="13"
                                      Stretch="Uniform" Fill="{DynamicResource AccentBrush}" Margin="0,0,6,0" />
                                <TextBlock Text="Optimize memory" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Row="1" Text="{Binding MemoryActionStatus}"
                                   Style="{StaticResource WidgetSubStyle}" Margin="8,6,8,0" TextWrapping="Wrap" TextTrimming="None"
                                   AutomationProperties.LiveSetting="Polite"
                                   ToolTip="{Binding MemoryActionStatus}"
                                   Visibility="{Binding HasMemoryActionStatus, Converter={StaticResource BoolVisibility}}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
        </Popup>
    </Grid>
</Window>
