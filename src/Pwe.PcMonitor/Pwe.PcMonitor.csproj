<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PwePcMonitor</AssemblyName>
    <RootNamespace>Pwe.PcMonitor</RootNamespace>
    <Version>0.1.0</Version>
    <Authors>PWE Group Pty Ltd</Authors>
    <Company>PWE Group Pty Ltd</Company>
    <Product>PWE PC MONITOR</Product>
    <Description>A calm, brand-led Windows hardware monitor.</Description>
    <Copyright>Copyright © 2026 PWE Group Pty Ltd</Copyright>
    <Platforms>AnyCPU;x64;ARM64</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\AppIcon.png" />
    <Resource Include="Resources\AppIcon.ico" />
    <Resource Include="Resources\Fonts\Inter.ttf" />
    <Resource Include="Resources\Fonts\PlayfairDisplay.ttf" />
  </ItemGroup>
</Project>
